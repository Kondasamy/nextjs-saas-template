# Database Configuration
# Get these from your database provider (e.g., Supabase, Neon, PlanetScale)
DATABASE_URL="postgresql://user:password@host:5432/database?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/database"

# Authentication (Better Auth)
# Generate a random 32+ character string for the secret
BETTER_AUTH_SECRET="your-secret-key-min-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth Providers (Optional)
# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Microsoft OAuth
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Supabase (Optional - for storage and realtime)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Email Service (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="noreply@yourcompany.com"
EMAIL_FROM_NAME="Your Company"

# Marketing Email Services (Optional)
MAILCHIMP_API_KEY=""
LOOPS_API_KEY=""
CONVERTKIT_API_KEY=""

# SSO Providers (Optional - for enterprise features)
SAML_ENTITY_ID=""
SAML_SSO_URL=""
OKTA_CLIENT_ID=""
OKTA_CLIENT_SECRET=""

# Admin Configuration
# Comma-separated list of admin email addresses
ADMIN_EMAILS="admin@yourcompany.com"

# Monitoring & Analytics (Optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_GA_ID=""

# Search indexing (Optional, build-time)
# Set to "true" when running `pnpm build` to send X-Robots-Tag: noindex, nofollow
# on every route (e.g. an app subdomain). Setting it only at runtime has no effect.
NOINDEX=""

# Development
NODE_ENV="development"
